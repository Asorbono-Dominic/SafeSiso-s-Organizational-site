{
  "name": "safesiso",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:messages": "node scripts/check-messages.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:a11y": "node scripts/check-a11y-structure.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:cms": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-cms-roundtrip.mjs",
    "review:build": "node scripts/build-translation-review.mjs",
    "review:apply": "node scripts/apply-translation-review.mjs",
    "cms:schema": "node scripts/build-sanity-schema.mjs",
    "cms:seed": "node scripts/export-content-for-cms.mjs",
    "lighthouse": "lhci autorun --config=lighthouserc.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "^16.3.0",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
