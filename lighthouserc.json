{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "screenEmulation": {
          "mobile": true,
          "width": 360,
          "height": 640,
          "deviceScaleFactor": 2,
          "disabled": false
        },
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4,
          "requestLatencyMs": 562.5,
          "downloadThroughputKbps": 1474.5,
          "uploadThroughputKbps": 675
        },
        "skipAudits": ["uses-http2", "canonical", "is-crawlable"]
      },
      "url": [
        "http://localhost:3000/en",
        "http://localhost:3000/en/how-it-works",
        "http://localhost:3000/en/about",
        "http://localhost:3000/en/safety",
        "http://localhost:3000/en/impact",
        "http://localhost:3000/en/safeher",
        "http://localhost:3000/en/get-involved",
        "http://localhost:3000/en/faq",
        "http://localhost:3000/en/media",
        "http://localhost:3000/en/contact",
        "http://localhost:3000/en/privacy",
        "http://localhost:3000/en/terms",
        "http://localhost:3000/en/portal",
        "http://localhost:3000/fr",
        "http://localhost:3000/fr/safety"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:performance": ["warn", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lh/reports" }
  }
}
