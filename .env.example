# SafeSiso website — environment template
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# Values marked [PENDING] do not exist yet and are tracked in the README's
# "Outstanding values needed from the client" table.

# ---------------------------------------------------------------------------
# Public — safe to expose to the browser (NEXT_PUBLIC_* is inlined into the JS
# bundle). Never put a secret behind this prefix.
# ---------------------------------------------------------------------------

# Canonical public origin, used for metadata/canonical URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# The SafeSiso WhatsApp number behind every "Start a Private Chat" CTA.
# Any common format is accepted and normalized for the wa.me link — local
# ("0257514846"), spaced international ("+233 25 751 4846"), or bare
# ("233257514846"). Ghana (+233) is assumed for local-format numbers.
# Changing this is an env change only; no code edit is required.
# Currently an INTERIM personal line — replace with the dedicated Twilio
# WhatsApp Business number before public launch.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Ghana Data Protection Commission registration number, shown in the footer
# and Privacy Policy. Blank renders a visible [PENDING] marker.
NEXT_PUBLIC_DPC_REGISTRATION_NUMBER=""

# A crisis/emergency contact for the Safety & Your Privacy page.
# DO NOT SET THIS until PPAG/UNFPA confirm the line is currently staffed.
# Publishing an unanswered emergency number to this audience is worse than
# publishing none at all.
NEXT_PUBLIC_CRISIS_CONTACT=""

# Contact addresses. These are for partners, funders and journalists — never
# advertise an inbox to the girls themselves (see Spec Section 9).
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_PRESS_EMAIL=""

# Set to any non-empty value once PPAG/UNFPA have reviewed and approved the
# Privacy Policy and Terms of Use. Until then both pages carry a visible draft
# notice, because publishing an unreviewed policy as final would be a false
# statement about how a minor's data is handled.
NEXT_PUBLIC_LEGAL_SIGN_OFF=""

# ---------------------------------------------------------------------------
# Server-only — never prefixed with NEXT_PUBLIC. These stay on the Next.js
# server, which proxies the backend so the browser never sees it (Spec 8.2).
# ---------------------------------------------------------------------------

# FastAPI chatbot backend. Consumed only by Route Handlers under /app/api.
# [PENDING] backend readiness gates Phase 6 — leave blank until confirmed.
SAFESISO_API_BASE_URL=""
SAFESISO_API_KEY=""

# NextAuth.js session signing (Phase 5 — SafeHer partner portal).
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Sanity.io CMS (Phase 7 — not required before then)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_READ_TOKEN=""

# ---------------------------------------------------------------------------
# Analytics (Phase 8 — cookie-less, no Google Analytics)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
