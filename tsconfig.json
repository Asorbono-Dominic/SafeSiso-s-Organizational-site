{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // `studio/` is a SEPARATE application — the Sanity Studio content editors
  // use. It has its own package.json and its own dependencies, and this site
  // never imports it. Its files import the `sanity` package, which is
  // deliberately not a dependency here, so typechecking them against this
  // project would fail on an import that is correct where it actually runs.
  "exclude": ["node_modules", "studio"]
}
