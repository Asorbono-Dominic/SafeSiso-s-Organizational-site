{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // `sanity/` holds generated Studio schema files. They are an artefact for a
  // SEPARATE Sanity Studio project — this app never imports them, and they
  // import the `sanity` package, which is deliberately not a dependency here.
  // Typechecking them against this project would fail on an import that is
  // correct in the place they actually run.
  "exclude": ["node_modules", "sanity"]
}
